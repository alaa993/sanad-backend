PORT=3000
SOCKET_PATH=/socket/
SOCKET_ALLOWED_ORIGINS=https://dashboard.sanadhub.cloud
REALTIME_SOCKET_TOKEN=change-me-to-match-laravel
# Verifies Socket.IO userId against Laravel Sanctum (recommended in production)
AUTH_VERIFY_URL=https://dashboard.sanadhub.cloud/api/auth/me
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
COMMUNITY_GLOBAL_EVENTS=true
