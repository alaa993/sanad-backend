APP_NAME=Sanad
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dashboard.sanadhub.cloud

# Sanad website & App Store
SANAD_COMPANY_NAME=سند
SANAD_SUPPORT_EMAIL=support@sanad.app
SANAD_PRIVACY_EMAIL=privacy@sanad.app
SANAD_APP_STORE_URL=
SANAD_PLAY_STORE_URL=
SANAD_SESSION_PRICE_POINTS=100
SANAD_SESSION_PRICE_WALLET=100

# SMS OTP (log | http)
SMS_DRIVER=log
SMS_HTTP_URL=
SMS_HTTP_AUTH=
SMS_OTP_TTL=10

# MTN Mobile Money (sandbox accepts any transaction_id >= 4 chars)
MTN_ENABLED=true
MTN_SANDBOX=true
MTN_API_URL=https://sandbox.momodeveloper.mtn.com
MTN_SUBSCRIPTION_KEY=
MTN_API_USER=
MTN_API_KEY=
MTN_CURRENCY=SYP
MTN_USSD_SHORT_CODE=*123#
MTN_CALLBACK_URL=

# Optional: only for first deploy / staging seed (never use defaults in production)
ADMIN_SEED_EMAIL=admin@sanad.local
ADMIN_SEED_PASSWORD=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sanad_db
DB_USERNAME=sanad
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Realtime (Socket.IO) — token must match realtime-server .env
REALTIME_SOCKET_URL=https://dashboard.sanadhub.cloud
REALTIME_SOCKET_PATH=/socket/
REALTIME_SOCKET_TOKEN=
REALTIME_INTERNAL_URL=http://127.0.0.1:3000

# LiveKit (group / session video)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Push — Android (FCM legacy server key or HTTP v1 via service account if extended later)
FCM_SERVER_KEY=

# Push — iOS (APNs auth key from Apple Developer)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.sanad.sanadapp.ios
APNS_PRIVATE_KEY=
APNS_SANDBOX=false

# Sign in with Apple (Services ID / bundle used to validate id_token)
APPLE_CLIENT_ID=

# Facebook Login
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@sanad.app"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
